/meta/
\title\(GCC MinGW-w64)
\author\(Brecht Sanders / WinLibs)
\version\(16.1.0)
\description\(Kompletny kompilator C/C++ dla Windowsa (GCC + MinGW-w64 + UCRT + POSIX + SEH))
\category\(compilers)

/execution/
\sources\(https://github.com/brechtsanders/winlibs_mingw/releases/download/16.1.0posix-14.0.0-ucrt-r4/winlibs-x86_64-posix-seh-gcc-16.1.0-mingw-w64ucrt-14.0.0-r4.zip)
\extract_dir\(gcc)
\target_bin\(bin/gcc.exe)
\run_after\(powershell -Command "[Environment]::SetEnvironmentVariable('Path', [Environment]::GetEnvironmentVariable('Path', 'User') + ';{INSTALL_DIR}\gcc\bin', 'User')")
